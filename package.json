{
  "name": "sistema-gestion-soporte",
  "version": "1.0.0",
  "description": "Sistema de gestión de soporte técnico e incidencias - Alcaldía Angostura del Orinoco",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "deploy:prepare-db": "cd server && npm run deploy:prepare",
    "deploy:start": "cd server && npm run deploy:start",
    "build:server": "cd server && npm install --omit=dev",
    "deploy:verify": "node deploy/scripts/verify-prod.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "mariadb": "^3.5.1"
  }
}
