# URL del API (desarrollo local con proxy de Vite)
VITE_API_URL=/api

# Cloudflare Turnstile (CAPTCHA en registro, recuperación y reenvío de verificación)
# Desarrollo: clave de prueba oficial (siempre pasa)
# Site key de prueba: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
