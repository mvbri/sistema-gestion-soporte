# Producción: Vercel (frontend) + Render (backend) + TiDB + Cloudinary + Resend
# cp server/.env.production.example server/.env

# --- Base de datos (TiDB Cloud Starter) ---
DB_HOST=gateway01.xxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxx.root
DB_PASSWORD=CAMBIAR
DB_NAME=sistema_soporte
DB_SSL=true
# Collation en dumps/restores (TiDB no soporta utf8mb4_uca1400_* de MariaDB)
DB_BACKUP_COLLATION=utf8mb4_bin

# --- JWT ---
JWT_SECRET=CAMBIAR_generar_secreto_aleatorio_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# --- Servidor ---
PORT=5000
NODE_ENV=production

# --- CORS (Vercel) ---
FRONTEND_URL=https://tu-app.vercel.app
CORS_ORIGINS=https://tu-app.vercel.app
# true = permitir cualquier *.vercel.app (previews)
CORS_ALLOW_VERCEL_PREVIEWS=true

# --- Email: resend (Render) | smtp (local con Gmail) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_CAMBIAR
EMAIL_FROM=Sistema de Soporte <noreply@alcaldia-angostura.gob.ve>

# Solo desarrollo local (EMAIL_PROVIDER no definido o smtp):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=cuenta@gmail.com
# EMAIL_PASS=app_password

# --- Uploads: cloudinary (Render) | disk (local) ---
UPLOAD_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_FOLDER=sistema-soporte/tickets
