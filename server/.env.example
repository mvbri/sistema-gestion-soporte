# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sistema_soporte

# true para BD gestionada en la nube (Aiven, TiDB); false para MariaDB local en VPS
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Si true, omite la verificación de migraciones/columnas al arrancar (solo emergencias locales)
# SKIP_SCHEMA_CHECK=true

# Email local: Gmail SMTP. NO definir EMAIL_PROVIDER en desarrollo.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@alcaldia-angostura.gob.ve

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Producción (Render): copiar .env.production.example — SendGrid + Cloudinary + TiDB
# EMAIL_PROVIDER=sendgrid, SENDGRID_API_KEY, UPLOAD_PROVIDER=cloudinary, etc.
# Guía: deploy/README.md
